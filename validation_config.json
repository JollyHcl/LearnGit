  "test_scenarios": [
    {
      "name": "基本一致性测试",
      "description": "验证SQL和Python处理结果的基本一致性",
      "tolerance": 0.01,
      "expected_consistency": 99.0
    },
    {
      "name": "分箱边界测试",
      "description": "验证分箱边界计算的准确性",
      "tolerance": 0.001,
      "expected_consistency": 100.0
    },
    {
      "name": "异常值处理测试",
      "description": "验证-9999异常值的处理一致性",
      "focus": "异常值分箱",
      "expected_consistency": 100.0
    }
  ]
