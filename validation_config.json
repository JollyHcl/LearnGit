    },
    "postgresql": {
      "host": "localhost",
      "port": 5432,
      "user": "your_username",
      "password": "your_password",
      "database": "your_database"
    },
    "sqlite": {
      "database": "your_database.db"
    }
  },
  
  "table_config": {
    "table_name": "your_table_name",
    "columns": {
      "risk_time": "risk_time",
      "pred_score": "pred_score"
    }
  },
  
  "validation_params": {
    "tolerance": 0.01,
    "bin_count": 10,
    "base_days": 6,
    "analysis_days": 100,
    "sample_size": null
